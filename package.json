{
  "name": "multi-client-template",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "scripts/dev.sh",
    "dev:setup": "scripts/dev.sh --no-start",
    "desktop": "pnpm --filter desktop start",
    "mobile": "pnpm --filter mobile start",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r --parallel typecheck",
    "iac:render": "vertile-iac render --target=vercel --env=production"
  },
  "devDependencies": {
    "@vertile-ai/iac": "0.2.1"
  }
}
