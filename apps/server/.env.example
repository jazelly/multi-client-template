# Local development values. scripts/dev.sh copies this to .env when .env is missing.
PORT=3100
DATABASE_URL=postgres://app:app@127.0.0.1:5434/app
# Public address of this server: the OAuth issuer and the audience of the phone app's access tokens.
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-every-real-environment
# Other origins that call this server from a browser: the Vite dev server and the Expo web dev server.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8081
# Password of the seeded test sign-ins (owner@test.com, editor@test.com, viewer@test.com).
TEST_ACCOUNT_PASSWORD=test-password-123
